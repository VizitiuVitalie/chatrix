# === Postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5533
POSTGRES_USER=chatrix_user_prod
POSTGRES_PASSWORD=change_me_strong_db_password_prod
POSTGRES_DB=chatrix_db_prod
POSTGRES_SCHEMA=chatrix_schema_prod

# === Backend ===
BACKEND_PORT=4321
NODE_ENV=production

# === CORS ===
FRONTEND_ORIGIN=https://your-ngrok-domain.ngrok-free.app

# === JWT ===
JWT_ACCESS_SECRET=change_me_with_openssl_rand_hex_64
JWT_ACCESS_TTL=15m
REFRESH_TTL=7d

# === Cookies ===
COOKIE_DOMAIN=
COOKIE_DOMAIN_LEGACY=
COOKIE_SECURE=true

# === File storage (MinIO via S3 API) ===
MAX_UPLOAD_SIZE_MB=25
DEFAULT_USER_QUOTA_MB=500

S3_PORT=9000
S3_CONSOLE_PORT=9001

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=chatrix-files-prod

S3_ACCESS_KEY=chatrix_admin
S3_SECRET_KEY=change_me_strong_s3_secret

S3_PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app/storage

# === Web push (VAPID) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/your-org/your-repo
