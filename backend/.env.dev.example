# === Postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5532
POSTGRES_USER=chatrix_user_dev
POSTGRES_PASSWORD=chatrix_pass_dev
POSTGRES_DB=chatrix_db_dev
POSTGRES_SCHEMA=chatrix_schema_dev

# === Backend ===
BACKEND_PORT=4321
NODE_ENV=development

# === CORS ===
FRONTEND_ORIGIN=http://localhost:5173

# === JWT ===
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
REFRESH_TTL=7d

# === Cookies ===
COOKIE_DOMAIN=
COOKIE_DOMAIN_LEGACY=
COOKIE_SECURE=false

# === File storage (MinIO via S3 API) ===
MAX_UPLOAD_SIZE_MB=25
DEFAULT_USER_QUOTA_MB=500

S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatrix-files-dev

S3_ACCESS_KEY=chatrix_admin
S3_SECRET_KEY=chatrix_secret_change_me

S3_PUBLIC_URL=http://localhost:9000/chatrix-files-dev

# === Web push (VAPID) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/your-org/your-repo

