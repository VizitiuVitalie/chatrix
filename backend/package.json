{
  "name": "@chatrix/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:up": "docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "build:spa": "node infra/scripts/build-spa.mjs",
    "tunnel:prod": "dotenv -e infra/.env.prod.infra -- node infra/scripts/tunnel.mjs",
    "docker:up:prod": "docker compose --env-file .env.prod -f infra/docker/docker-compose.prod.yml up -d --build",
    "docker:down:prod": "docker compose --env-file .env.prod -f infra/docker/docker-compose.prod.yml down",
    "docker:logs:prod": "docker compose -f infra/docker/docker-compose.prod.yml logs -f",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "yarn typeorm migration:create ./src/core/database/migrations/migration",
    "migration:run:container": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/core/database/data-source.js",
    "migration:generate:dev": "dotenv -e .env.dev -- yarn typeorm migration:generate -d ./src/core/database/data-source.ts ./src/core/database/migrations/migration",
    "migration:run:dev": "dotenv -e .env.dev -- yarn typeorm migration:run -d ./src/core/database/data-source.ts",
    "migration:revert:dev": "dotenv -e .env.dev -- yarn typeorm migration:revert -d ./src/core/database/data-source.ts",
    "migration:show:dev": "dotenv -e .env.dev -- yarn typeorm migration:show -d ./src/core/database/data-source.ts",
    "migration:fake:dev": "dotenv -e .env.dev -- yarn typeorm migration:run -d ./src/core/database/data-source.ts --fake",
    "migration:generate:prod": "dotenv -e .env.prod -- yarn typeorm migration:generate -d ./src/core/database/data-source.ts ./src/core/database/migrations/migration",
    "migration:run:prod": "dotenv -e .env.prod -- yarn typeorm migration:run -d ./src/core/database/data-source.ts",
    "migration:revert:prod": "dotenv -e .env.prod -- yarn typeorm migration:revert -d ./src/core/database/data-source.ts",
    "migration:show:prod": "dotenv -e .env.prod -- yarn typeorm migration:show -d ./src/core/database/data-source.ts",
    "migration:fake:prod": "dotenv -e .env.prod -- yarn typeorm migration:run -d ./src/core/database/data-source.ts --fake"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.21",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "file-type": "^22.0.1",
    "joi": "^17.13.3",
    "ms": "^2.1.3",
    "nestjs-pino": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
